# Auto-activate the project venv when you `cd` into the repo (with direnv).
#
# Setup, one-time per developer:
#
#     brew install direnv             # or: apt install direnv
#     echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc   # or .bashrc
#     cd hallPassAttendanceOfficer
#     direnv allow .                  # required after every change to this file
#
# Pattern: source-if-exists. The venv itself is created by `quickstart.sh`
# or `make install`; this just makes the shell aware of it on subsequent
# `cd`s. We deliberately do NOT auto-create the venv here -- letting
# quickstart.sh own creation keeps the Python version honest (it pairs
# with .python-version + pyenv) and avoids racing with the script.
if [[ -d .venv ]]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
fi
