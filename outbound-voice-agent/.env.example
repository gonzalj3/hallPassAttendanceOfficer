OPENAI_API_KEY=sk-your-api-key
PORT=5178
SAFETY_IDENTIFIER=outbound-voice-agent-local

# Optional: when set, the voice agent POSTs each finished call to the ABE
# backend (signed with X-HPAO-Signature) so the admin dashboard sees it.
# Without these, calls only land in the local CSV files.
BACKEND_URL=http://localhost:8000
BACKEND_HMAC_SECRET=
