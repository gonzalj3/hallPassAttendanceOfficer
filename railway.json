{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "uvicorn --factory hpao.app:app_factory --host 0.0.0.0 --port $PORT",
    "preDeployCommand": "alembic upgrade head && python -m hpao.cli.seed && python -m hpao.cli.seed_avery",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  }
}
