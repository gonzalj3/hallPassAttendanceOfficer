# Copy to `.env.local` for local dev (gitignored).
# On Netlify, set these via Site settings -> Environment.

# REST base. Defaults to http://localhost:8731 if unset.
VITE_API_URL=http://localhost:8731

# WebSocket base. Defaults to VITE_API_URL with http -> ws if unset.
# Use wss:// when serving the frontend over HTTPS.
VITE_WS_URL=ws://localhost:8731
