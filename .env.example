# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+asyncpg://lizzie:lizzie@localhost:5432/lizzie
APP_ENV=dev

# Signing secret for the role-picker session cookie. In production set a
# stable random value (>=32 bytes) so sessions survive restarts.
SESSION_COOKIE_SECRET=

# CORS allow-list (comma-separated). Localhost is always allowed via regex.
FRONTEND_ORIGIN=https://verdant-pie-1d3c9f.netlify.app
