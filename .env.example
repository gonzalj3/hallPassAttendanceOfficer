# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+asyncpg://hpao:hpao@localhost:5432/hpao
APP_ENV=dev

# OpenAI / hackathon Codex credentials (Phase 5c embeddings + Phase 7 agent loop).
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Phase 8 inter-agent boundary (parent-comms relay). Leave unset for local dev.
PARENT_COMMS_URL=
PARENT_COMMS_SECRET=
