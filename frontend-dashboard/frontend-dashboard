<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>HallPass Pro Admin — Operations Console</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Atkinson+Hyperlegible+Next:wght@400;600;700&display=swap" rel="stylesheet"/>
<style>
  body { font-family: 'Atkinson Hyperlegible Next', sans-serif; background:#e9eff0; color:#171d1e; }
  .heading { font-family: 'Lexend', sans-serif; }
  .num { font-family: 'Lexend', sans-serif; font-weight: 700; letter-spacing: -0.02em; }
  .pulse { animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.5} }
</style>
</head>
<body class="min-h-screen">
<div class="flex">
  <!-- Sidebar -->
  <aside class="w-60 bg-[#171d1e] text-white min-h-screen p-5">
    <div class="flex items-center gap-2 mb-8">
      <div class="w-8 h-8 rounded-lg bg-[#00818a] flex items-center justify-center font-bold heading">H</div>
      <div class="heading font-semibold">HallPass Pro</div>
    </div>
    <nav class="space-y-1 text-sm">
      <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-[#00666e]/30 text-white font-medium border-l-2 border-[#63d7e2]"><span>📊</span>Overview</a>
      <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#bcc9ca] hover:bg-white/5"><span>👥</span>Students</a>
      <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#bcc9ca] hover:bg-white/5"><span>🏫</span>Classrooms</a>
      <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#bcc9ca] hover:bg-white/5"><span>🚨</span>Alerts<span class="ml-auto bg-[#ba1a1a] text-white text-xs px-2 py-0.5 rounded-full num">14</span></a>
      <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#bcc9ca] hover:bg-white/5"><span>📈</span>Reports</a>
      <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#bcc9ca] hover:bg-white/5"><span>⚙️</span>Settings</a>
    </nav>
    <div class="mt-8 pt-5 border-t border-white/10">
      <div class="text-xs text-[#6d797b] uppercase font-semibold mb-2">System</div>
      <div class="text-sm flex items-center gap-2 mb-1.5"><span class="w-2 h-2 rounded-full bg-green-400 pulse"></span>API live</div>
      <div class="text-sm flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-green-400 pulse"></span>14 kiosks online</div>
    </div>
  </aside>

  <!-- Main -->
  <main class="flex-1 p-6">
    <!-- Top bar -->
    <div class="bg-white rounded-xl px-6 py-4 mb-5 flex items-center justify-between shadow-sm">
      <div>
        <h1 class="heading text-lg font-semibold">Lincoln High · Operations Overview</h1>
        <div class="text-xs text-[#6d797b]">Tuesday, May 12 · 10:42 AM · Period 3 in session</div>
      </div>
      <div class="flex gap-2 text-sm">
        <button class="px-3 py-1.5 rounded-lg bg-[#eff5f5] text-[#3d494a] font-medium">Today</button>
        <button class="px-3 py-1.5 rounded-lg text-[#6d797b]">Week</button>
        <button class="px-3 py-1.5 rounded-lg text-[#6d797b]">Month</button>
        <button class="px-3 py-1.5 rounded-lg bg-[#00666e] text-white font-medium">Export</button>
      </div>
    </div>

    <!-- Compact KPI strip -->
    <div class="grid grid-cols-6 gap-3 mb-5">
      <div class="bg-white rounded-xl p-4 shadow-sm">
        <div class="text-[10px] uppercase tracking-wide text-[#6d797b] font-semibold">Out Now</div>
        <div class="num text-2xl mt-1">12</div>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm">
        <div class="text-[10px] uppercase tracking-wide text-[#6d797b] font-semibold">Today Total</div>
        <div class="num text-2xl mt-1">187</div>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm">
        <div class="text-[10px] uppercase tracking-wide text-[#6d797b] font-semibold">Active Flags</div>
        <div class="num text-2xl mt-1 text-[#ba1a1a]">3</div>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm">
        <div class="text-[10px] uppercase tracking-wide text-[#6d797b] font-semibold">Avg Duration</div>
        <div class="num text-2xl mt-1">4:32</div>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm">
        <div class="text-[10px] uppercase tracking-wide text-[#6d797b] font-semibold">Adoption</div>
        <div class="num text-2xl mt-1">78%</div>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm">
        <div class="text-[10px] uppercase tracking-wide text-[#6d797b] font-semibold">Lockdowns</div>
        <div class="num text-2xl mt-1">0</div>
      </div>
    </div>

    <!-- Grid of widgets -->
    <div class="grid grid-cols-12 gap-5">

      <!-- Live activity feed -->
      <div class="col-span-5 bg-white rounded-xl p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h3 class="heading font-semibold text-base">Live activity</h3>
          <span class="text-xs text-[#00666e] flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[#00818a] pulse"></span>Streaming</span>
        </div>
        <div class="space-y-2.5 text-sm">
          <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-[#ffdad6]/40">
            <div><span class="font-semibold">Marcus Thompson</span> · Restroom · Rm 204</div>
            <div class="num text-[#ba1a1a]">14:22 ⚠</div>
          </div>
          <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-[#eff5f5]">
            <div><span class="font-semibold">Aisha Patel</span> · Nurse · Rm 112</div>
            <div class="num text-[#3d494a]">06:08</div>
          </div>
          <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-[#eff5f5]">
            <div><span class="font-semibold">Jayden Rivera</span> · Office · Rm 308</div>
            <div class="num text-[#3d494a]">02:41</div>
          </div>
          <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-[#eff5f5]">
            <div><span class="font-semibold">Sofia Chen</span> · Hallway · Rm 215</div>
            <div class="num text-[#3d494a]">01:15</div>
          </div>
          <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-[#eff5f5]">
            <div><span class="font-semibold">Tyler O'Brien</span> · Restroom · Rm 109</div>
            <div class="num text-[#3d494a]">00:48</div>
          </div>
        </div>
      </div>

      <!-- Top classrooms bar -->
      <div class="col-span-4 bg-white rounded-xl p-5 shadow-sm">
        <h3 class="heading font-semibold text-base mb-4">Volume by classroom</h3>
        <div class="space-y-3 text-sm">
          <div><div class="flex justify-between mb-1"><span>Garcia · 204</span><span class="num">34</span></div><div class="h-2 bg-[#eff5f5] rounded-full"><div class="h-full bg-[#00666e] rounded-full" style="width:100%"></div></div></div>
          <div><div class="flex justify-between mb-1"><span>Patel · 112</span><span class="num">29</span></div><div class="h-2 bg-[#eff5f5] rounded-full"><div class="h-full bg-[#00666e] rounded-full" style="width:85%"></div></div></div>
          <div><div class="flex justify-between mb-1"><span>Cohen · 308</span><span class="num">24</span></div><div class="h-2 bg-[#eff5f5] rounded-full"><div class="h-full bg-[#00818a] rounded-full" style="width:71%"></div></div></div>
          <div><div class="flex justify-between mb-1"><span>Reyes · 215</span><span class="num">22</span></div><div class="h-2 bg-[#eff5f5] rounded-full"><div class="h-full bg-[#00818a] rounded-full" style="width:65%"></div></div></div>
          <div><div class="flex justify-between mb-1"><span>Brooks · 109</span><span class="num">19</span></div><div class="h-2 bg-[#eff5f5] rounded-full"><div class="h-full bg-[#63d7e2] rounded-full" style="width:56%"></div></div></div>
        </div>
      </div>

      <!-- Capacity status -->
      <div class="col-span-3 bg-white rounded-xl p-5 shadow-sm">
        <h3 class="heading font-semibold text-base mb-4">Capacity</h3>
        <div class="space-y-3">
          <div class="flex items-center justify-between p-3 rounded-lg bg-[#ffdad6]/40 border border-[#ffdad6]">
            <div><div class="text-sm font-semibold">Restroom</div><div class="text-xs text-[#6d797b]">Full</div></div>
            <div class="num text-lg text-[#ba1a1a]">2/2</div>
          </div>
          <div class="flex items-center justify-between p-3 rounded-lg bg-[#eff5f5]">
            <div><div class="text-sm font-semibold">Nurse</div><div class="text-xs text-[#6d797b]">Available</div></div>
            <div class="num text-lg text-[#00666e]">1/3</div>
          </div>
          <div class="flex items-center justify-between p-3 rounded-lg bg-[#eff5f5]">
            <div><div class="text-sm font-semibold">Office</div><div class="text-xs text-[#6d797b]">Available</div></div>
            <div class="num text-lg text-[#00666e]">2/5</div>
          </div>
          <div class="flex items-center justify-between p-3 rounded-lg bg-[#eff5f5]">
            <div><div class="text-sm font-semibold">Hallway</div><div class="text-xs text-[#6d797b]">No limit</div></div>
            <div class="num text-lg text-[#3d494a]">7</div>
          </div>
        </div>
      </div>

      <!-- Hourly chart -->
      <div class="col-span-8 bg-white rounded-xl p-5 shadow-sm">
        <div class="flex items-end justify-between mb-3">
          <h3 class="heading font-semibold text-base">Movement by hour</h3>
          <span class="text-xs text-[#6d797b]">Bar: today · Line: 7-day avg</span>
        </div>
        <svg viewBox="0 0 700 180" class="w-full h-48">
          <g stroke="#eff5f5" stroke-width="1">
            <line x1="30" y1="30"  x2="690" y2="30"/>
            <line x1="30" y1="80"  x2="690" y2="80"/>
            <line x1="30" y1="130" x2="690" y2="130"/>
          </g>
          <g fill="#00818a">
            <rect x="50"  y="120" width="40" height="35"/>
            <rect x="120" y="100" width="40" height="55"/>
            <rect x="190" y="85"  width="40" height="70"/>
            <rect x="260" y="70"  width="40" height="85"/>
            <rect x="330" y="55"  width="40" height="100"/>
            <rect x="400" y="35"  width="40" height="120"/>
            <rect x="470" y="60"  width="40" height="95"/>
            <rect x="540" y="85"  width="40" height="70"/>
            <rect x="610" y="115" width="40" height="40"/>
          </g>
          <path d="M70,125 L140,108 L210,95 L280,80 L350,68 L420,50 L490,72 L560,95 L630,122" fill="none" stroke="#ba1a1a" stroke-width="2" stroke-dasharray="4,4"/>
          <g font-size="10" fill="#6d797b">
            <text x="55" y="172">8a</text><text x="125" y="172">9a</text><text x="195" y="172">10a</text>
            <text x="265" y="172">11a</text><text x="335" y="172">12p</text><text x="405" y="172">1p</text>
            <text x="475" y="172">2p</text><text x="545" y="172">3p</text><text x="615" y="172">4p</text>
          </g>
        </svg>
      </div>

      <!-- Frequent flyers compact -->
      <div class="col-span-4 bg-white rounded-xl p-5 shadow-sm">
        <h3 class="heading font-semibold text-base mb-4">Frequent flyers (week)</h3>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-[#eff5f5]">
            <tr><td class="py-2 font-semibold">Marcus Thompson</td><td class="py-2 text-right num">8</td></tr>
            <tr><td class="py-2 font-semibold">Aisha Patel</td><td class="py-2 text-right num">7</td></tr>
            <tr><td class="py-2 font-semibold">Jayden Rivera</td><td class="py-2 text-right num">6</td></tr>
            <tr><td class="py-2 font-semibold">Sofia Chen</td><td class="py-2 text-right num">6</td></tr>
            <tr><td class="py-2 font-semibold">Tyler O'Brien</td><td class="py-2 text-right num">5</td></tr>
          </tbody>
        </table>
      </div>

    </div>
  </main>
</div>
</body>
</html>
